  "workflows": [
    {
      "id": "project",
      "name": "将局部巡测投影到路线",
      "entry": "python3 -B -m railchain --db demo.sqlite publish examples/alignment.json",
      "success": "正反方向统一为全局毫米",
      "failure": "越出区段的观测拒绝",
      "verification": "python3 -B examples/smoke.py",
      "module_ids": [
        "reference",
        "slicing",
        "publication",
        "__main__"
      ],
      "steps": [
        "执行 publish examples/alignment.json",
        "正反方向统一为全局毫米"
      ]
    },
    {
      "id": "slice",
      "name": "生成覆盖分段",
      "entry": "python3 -B -m railchain --db demo.sqlite publish examples/alignment.json",
      "success": "可用、遮挡和空白区间全部出现",
      "failure": "同观测标识重复时拒绝",
      "verification": "python3 -B examples/smoke.py",
      "module_ids": [
        "reference",
        "slicing",
        "publication",
        "__main__"
      ],
      "steps": [
        "执行 publish examples/alignment.json",
        "可用、遮挡和空白区间全部出现"
      ]
    },
    {
      "id": "release",
      "name": "重放和读取独立成果版本",
      "entry": "python3 -B -m railchain --db demo.sqlite read quarry-branch alignment-blue",
      "success": "返回冻结事实及摘要",
      "failure": "版本未知或写入异值时拒绝",
      "verification": "python3 -B examples/smoke.py",
      "module_ids": [
        "__main__",
        "publication",
        "reference"
      ],
      "steps": [
        "执行 read quarry-branch alignment-blue",
        "返回冻结事实及摘要"
      ]
    },
    {
      "id": "shift_plan",
      "name": "开班计划与到达后改派",
      "entry": "python3 -B -m railchain --db demo.sqlite plan-shift examples/shift.json",
      "success": "按当时已知信息冻结一组开班作业并给出可比方案",
      "failure": "未到达通知、回撤通知、返还已耗分钟或改动已开始作业时拒绝",
      "verification": "python3 -B examples/shift_smoke.py",
      "module_ids": [
        "shift",
        "plan",
        "store",
        "coverage",
        "evidence",
        "reference",
        "__main__"
      ],
      "steps": [
        "执行 plan-shift examples/shift.json",
        "按当时已知信息冻结一组开班作业"
      ]
    },
    {
      "id": "daily_release",
      "name": "发布班终日常巡测成果",
      "entry": "python3 -B -m railchain --db demo.sqlite publish-daily examples/daily.json",
      "success": "分别给出已有观测与独立证据，保留整段复测缺口",
      "failure": "回执超出已签范围、补交同一回执或非独立车组不计足时拒绝或排除",
      "verification": "python3 -B examples/shift_smoke.py",
      "module_ids": [
        "daily",
        "evidence",
        "store",
        "coverage",
        "reference",
        "__main__"
      ],
      "steps": [
        "执行 publish-daily examples/daily.json",
        "分别给出已有观测与独立证据"
      ]
    }
  ],
